# Install to /etc/sudoers.d/lyly-admin-deploy with `visudo -cf` to check
# syntax first. Grants the github-runner user exactly what
# .github/workflows/deploy.yml needs to restart/verify the lyly-admin
# service — nothing else, and separate from lyly-admin's own sudoers scope
# in sudoers.example (different user, different purpose).

Cmnd_Alias LYLY_ADMIN_DEPLOY_CMDS = \
    /usr/bin/systemctl restart lyly-admin, \
    /usr/bin/systemctl is-active lyly-admin

github-runner ALL=(root) NOPASSWD: LYLY_ADMIN_DEPLOY_CMDS
