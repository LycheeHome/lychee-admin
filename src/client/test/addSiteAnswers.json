{
  "POST /sites/preview hostname=&type=static&port=&framework=none&healthcheckPath=": {
    "status": 200,
    "body": {
      "ready": false
    }
  },
  "POST /sites/preview hostname=blog.lychee.land&type=static&port=&framework=none&healthcheckPath=": {
    "status": 200,
    "body": {
      "ready": false,
      "error": "blog.lychee.land already exists in the Caddyfile"
    }
  },
  "POST /sites/preview hostname=shop.lychee.land&type=static&port=&framework=none&healthcheckPath=": {
    "status": 200,
    "body": {
      "ready": true,
      "preview": {
        "hostname": "shop.lychee.land",
        "caddy": {
          "path": "/etc/caddy/Caddyfile",
          "added": [
            "http://shop.lychee.land {",
            "\troot * /var/www/shop.lychee.land",
            "\tfile_server",
            "}"
          ]
        },
        "tunnel": {
          "path": "/etc/cloudflared/sites-config.yml",
          "added": [
            "  - hostname: shop.lychee.land",
            "    service: http://localhost:80"
          ],
          "contextAfter": "  - service: http_status:404"
        },
        "files": {
          "path": "/var/www/shop.lychee.land",
          "creates": [
            "index.html"
          ]
        },
        "steps": [
          {
            "id": "backup",
            "label": "Configs backed up",
            "willRun": true
          },
          {
            "id": "caddyfile",
            "label": "Caddyfile block appended",
            "willRun": true
          },
          {
            "id": "files",
            "label": "Site directory created",
            "willRun": true
          },
          {
            "id": "tunnel",
            "label": "Tunnel route added",
            "willRun": true
          },
          {
            "id": "caddy",
            "label": "Caddy validated and reloaded",
            "willRun": true
          },
          {
            "id": "cloudflared",
            "label": "cloudflared-sites restarted",
            "willRun": true
          }
        ]
      }
    }
  },
