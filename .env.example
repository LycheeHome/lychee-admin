# Network binding — LAN interface or loopback only. Never bind 0.0.0.0 and
# never point a Cloudflare Tunnel ingress rule at this app.
HOST=127.0.0.1
PORT=8787

# Basic auth (single user)
ADMIN_USERNAME=byron
# bcrypt hash of the admin password — generate with:
#   node -e "console.log(require('bcrypt').hashSync('your-password', 12))"
ADMIN_PASSWORD_HASH=

# Domain this app manages subdomains under
DOMAIN=lyly.dev

# Paths on the target host (lychee) — confirmed via SSH, see CLAUDE.md.
CADDYFILE_PATH=/etc/caddy/Caddyfile
# This is the "sites" tunnel's config, split off from the lychee-ssh tunnel
# so that lyly-admin's restarts (needed on every add/remove) never interrupt
# ssh.lyly.dev. See deploy/cloudflared-sites.service.
TUNNEL_CONFIG_PATH=/etc/cloudflared/sites-config.yml
# Must stay /var/www — deploy/lyly-admin-create-site-dir.sh hardcodes this
# path and the web:webdeploy owner/group, it does not read this value.
SITES_ROOT=/var/www
# The lychee-sites tunnel's ID — find it with `cloudflared tunnel list`, or read
# the `tunnel:` line of TUNNEL_CONFIG_PATH. Left blank deliberately: the site
# detail page falls back to dashboard instructions rather than printing a
# `cloudflared tunnel route dns` command with an empty ID in it.
TUNNEL_ID=

# Where backups of edited config files are written before mutation
BACKUP_DIR=/etc/lyly-admin/backups

# Audit log of every add/remove action
LOG_FILE=/var/log/lyly-admin/actions.log
