# Network binding — LAN interface or loopback only. Never bind 0.0.0.0 and
# never point a Cloudflare Tunnel ingress rule at this app.
HOST=127.0.0.1
PORT=8787

# Basic auth (single user)
ADMIN_USERNAME=byron
# bcrypt hash of the admin password — generate with:
#   node -e "console.log(require('bcrypt').hashSync('your-password', 12))"
ADMIN_PASSWORD_HASH=

# Domain this app manages subdomains under (required, no default)
DOMAIN=lychee.land

# Hostnames add-site must refuse (optional, comma-separated). List any hostname
# served by Caddy config this app never parses, such as the one serving this app.
RESERVED_HOSTNAMES=admin.lychee.land

# BACKUP_DIR (backups written before every config edit) and LOG_FILE (the audit
# log) are deliberately unset: the defaults, /etc/lychee-admin/backups and
# /var/log/lychee-admin/actions.log, are what the service unit makes writable;
# setting either to an old /lyly-admin/ path stops lychee-ops retiring the bridge.
