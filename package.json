{
  "name": "lychee-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Local admin app for managing Caddy + Cloudflare Tunnel sites on lychee",
  "main": "dist/server.js",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "concurrently -n tsx,css,client \"tsx watch src/server.ts\" \"tailwindcss -i src/styles/tailwind.css -o public/style.css --watch\" \"vite build --watch\"",
    "dev:mock": "concurrently -n tsx,css,client \"tsx watch src/dev/server.ts\" \"tailwindcss -i src/styles/tailwind.css -o public/style.css --watch\" \"vite build --watch\"",
    "build:css": "tailwindcss -i src/styles/tailwind.css -o public/style.css --minify",
    "build:client": "vite build",
    "build": "npm run build:css && npm run build:client && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "pretest": "sh scripts/fetch-contract.sh",
    "test": "tsx --tsconfig tsconfig.test.json --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.client.json",
    "lint": "eslint src",
    "test:contract": "tsx src/dev/contract/emitDeclarations.ts && python3 scripts/check-declarations.py"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@testing-library/react": "^16.3.3",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "8.20.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.1",
    "vite": "^8.3.5"
  }
}
